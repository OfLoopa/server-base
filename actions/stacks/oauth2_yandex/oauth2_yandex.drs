Options name: 'oauth2'

# Postgres is required by oauth2-yandex for session and OAuth state storage
Service :postgres, image: 'postgres:16-alpine' do
  deploy placement: { constraints: ['node.role == manager'] }
  network :default
  env POSTGRES_DB: 'oauth2_yandex',
      POSTGRES_USER: 'oauth2_yandex',
      POSTGRES_PASSWORD: ENV.fetch('POSTGRES_PASSWORD', 'changeme')
  volume name: 'oauth2_yandex_pgdata', target: '/var/lib/postgresql/data'
end

Service :oauth2_yandex, image: 'levsab/oauth2-yandex:latest', ports: 8080 do
  deploy placement: { constraints: ['node.role == manager'] }
  network :default
  network :grafana_network, name: 'grafana-network', external: true
  deploy_label 'metrics.port=8080'

  # Public path for the OAuth callback from Yandex; ForwardAuth is called internally on /auth
  # Register https://<MAIN_DOMAIN>/oauth_yandex/oauth/callback in your Yandex OAuth app
  ingress path: '/oauth_yandex', path_sub: ['/oauth_yandex(.*)', '$1']

  env PORT: 8080

  # Encore runtime config
  env ENCORE_ENV_NAME: ENV.fetch('ENCORE_ENV_NAME', 'production'),
      ENCORE_ENV_TYPE: ENV.fetch('ENCORE_ENV_TYPE', 'production'),
      ENCORE_INFRA_CONFIG_PATH: '/app/infra-config.json'

  # These must match the Postgres service and the infra-config below
  env POSTGRES_HOST: 'oauth2_postgres:5432',
      POSTGRES_DB: 'oauth2_yandex',
      POSTGRES_USER: 'oauth2_yandex',
      POSTGRES_PASSWORD: ENV.fetch('POSTGRES_PASSWORD', 'changeme'),
      POSTGRES_TLS_DISABLED: 'true'

  env YA_AUTH_BASE_URL: "https://#{ENV.fetch('MAIN_DOMAIN', 'example.com')}/oauth_yandex"
  env YA_AUTH_ALLOWED_RETURN_HOSTS: ENV.fetch('MAIN_DOMAIN', 'example.com')
  env YA_AUTH_DEFAULT_REDIRECT_URL: "https://#{ENV.fetch('MAIN_DOMAIN', 'example.com')}/"
  env YA_AUTH_COOKIE_DOMAIN: ".#{ENV.fetch('MAIN_DOMAIN', 'example.com')}"

  # At least one of these must be non-empty; or set YA_AUTH_DEV_ALLOW_ALL=true for local dev
  env YA_AUTH_ALLOWED_EMAILS: ENV.fetch('YA_AUTH_ALLOWED_EMAILS', 'a.veder'),
      YA_AUTH_ALLOWED_EMAIL_DOMAINS: ENV.fetch('YA_AUTH_ALLOWED_EMAIL_DOMAINS', '@eksli.ru'),
      YA_AUTH_ALLOWED_LOGINS: ENV.fetch('YA_AUTH_ALLOWED_LOGINS', '')

  # Encore SQL infra config — encore_name must match the database name declared in the app source
  config target: '/app/infra-config.json', file_content: <<~JSON
    {
      "metadata": {
        "app_id": "oauth2-yandex",
        "env_name": "#{ENV.fetch('ENCORE_ENV_NAME', 'production')}",
        "env_type": "#{ENV.fetch('ENCORE_ENV_TYPE', 'production')}"
      },
      "sql_databases": [
        {
          "encore_name": "oauth2yandex",
          "cloud_name": "oauth2_yandex",
          "server": {
            "host": "oauth2_postgres:5432",
            "tls_config": { "disabled": true }
          },
          "username": "oauth2_yandex",
          "password": "#{ENV.fetch('POSTGRES_PASSWORD', 'changeme')}"
        }
      ]
    }
  JSON
end

Volume :oauth2_yandex_pgdata, name: 'oauth2_yandex_pgdata'
Network :grafana_network, external: true, name: 'grafana-network'
